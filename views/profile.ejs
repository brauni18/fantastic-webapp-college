<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit profile - Journey the Nightscape</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="stylesheet" href="/universal.css" type="text/css">
</head>

<body>
  <!-- Invisible hover area to trigger navbar -->
  <div id="navbar-hover-area" style="position:fixed;top:0;left:0;width:100vw;height:120px;z-index:9999;"></div>
  <header>
  <!-- </header>
  <div class="flex flex-col w-screen h-screen-without-header-large dark:bg-global-black">
    <div class="w-screen h-screen-without-header-large flex-grow dark:bg-[#090F11] bg-neutral-background-medium"
      style="mask-image: url('https://www.redditstatic.com/shreddit/assets/account/standalone-auth-bg.svg'); mask-size: cover; mask-type: alpha;">
    </div>
  </div> -->

  <% if (typeof success !=='undefined' && success) { %>
    <div class="container center-container mt-4 text-center d-flex flex-column">
      <div class="card-body">
        <div class="success">
          <%= success %>
        </div>
        <a href="/" class="btn btn-primary mt-3">Back to login page</a>
      </div>
    </div>
    <% } else { %>
      <form id="register-form" class="form-signin" action="/update-profile" method="POST">
        <div id="container" class="container center-container mt-4 text-center d-flex flex-column">
          <div class="content-wrapper">
            <div class="card-body">
                            <div class ="card-title" style="margin-bottom: 20px;">
                Logged in as: <b><%= user.username %></b>
              </div>
              <h5 class="card-title"><b>Edit Profile</b></h5>

              <div class="mb-2">
                <div class="floating-label-group">
                  <input type="text" name="username" class="form-control custom-input uniform-width" placeholder=" ">
                  <label for="username">Username</label>
                </div>
              </div>
              <div class="mb-2">
                <div class="floating-label-group">
                  <input type="email" name="email" class="form-control custom-input uniform-width" placeholder=" ">
                  <label for="email">Email</label>
                </div>
              </div>
              <div class="mb-2">
                <div class="floating-label-group">
                  <input type="password" name="password" class="form-control custom-input uniform-width"
                    placeholder=" ">
                  <label for="password">Password</label>
                </div>
              </div>
              <div class="mb-2">
                <div class="floating-label-group">
                  <input type="text" name="firstName" class="form-control custom-input uniform-width" placeholder=" ">
                  <label for="firstName">First Name</label>
                </div>
              </div>
              <div class="mb-2">
                <div class="floating-label-group">
                  <input type="text" name="lastName" class="form-control custom-input uniform-width" placeholder=" ">
                  <label for="lastName">Last Name</label>
                </div>
              </div>
              <div class="mb-2">
                <div class="floating-label-group">
                  <textarea name="bio" class="form-control custom-input uniform-width" placeholder="Bio (max 300 chars)"
                    maxlength="300" style="resize:none; width:100%; box-sizing:border-box;"></textarea>
                  <!-- <label for="bio">Bio</label> -->
                </div>
              </div>
              <div>
              <div style="margin-bottom:5px;">
                <label for="avatar">Profile Picture:</label>
                <label for="avatar" class="btn btn-secondary uniform-width" style="cursor:pointer;">
                  Choose Image
                  <input type="file" name="avatar" id="avatar" accept="image/*" style="display:none;">
                </label>
                <span id="avatar-filename" style="margin-left:10px; margin-bottom:none;"></span>
              </div>
                <script>
                  document.addEventListener('DOMContentLoaded', function () {
                    var avatarInput = document.getElementById('avatar');
                    var avatarFilename = document.getElementById('avatar-filename');
                    avatarInput.addEventListener('change', function () {
                      if (avatarInput.files.length > 0) {
                        avatarFilename.textContent = avatarInput.files[0].name;
                      } else {
                        avatarFilename.textContent = '';
                      }
                    });
                  });
                </script>
                <!--<img src="/images/john-doe.png" alt="Default Avatar" style="width:80px;height:80px;margin:10px 0;">-->
              </div>
              <% if (typeof error !=='undefined' && error) { %>
                <div class="error">
                  <%= error %>
                </div>
                <% } %>
                  <div style="display: flex; gap: 10px; justify-content: center; margin-top: 10px;">
                    <button type="submit" class="btn btn-secondary uniform-width">Save Changes</button>
                    <button type="button" class="btn btn-danger" id="deleteButton">Delete User</button>
                    <a href="/" class="btn btn-primary uniform-width" style="text-decoration:none;">Return to Home</a>
                  </div>
            </div>
          </div>
        </div>
      </form>
      <% } %>
        <div id="deleteModal"
          style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.5); justify-content:center; align-items:center;">
          <div style="background:#fff; padding:20px; border-radius:8px; text-align:center;">
            <p>Are you sure you want to delete your account?</p>
            <form id="deleteUserForm" method="POST" action="/users/delete">
              <input type="hidden" name="username" value="<%= user.username %>">
              <button type="submit" class="btn btn-danger">Yes, Delete</button>
              <button type="button" class="btn btn-success" id="cancelDeleteBtn">No, Cancel</button>
            </form>
          </div>
        </div>
        <script>
          const deleteBtn = document.getElementById('deleteUserBtn');
          const modal = document.getElementById('deleteModal');
          const cancelBtn = document.getElementById('cancelDeleteBtn');

          deleteButton.onclick = () => { modal.style.display = 'flex'; };
          cancelDeleteBtn.onclick = () => { modal.style.display = 'none'; };
        </script>
</body>

</html>