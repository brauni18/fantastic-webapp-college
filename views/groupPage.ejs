<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/styles.css" />
    <title><%= group.name %> - Leylit</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col px-0 sidebar-col mr-4">
                <%- include('partials/sidebar') %>
            </div>

            <div id="group-header" class="group-header p-4 mb-4 rounded">
                <div id="group-name-header" class="text-center">
                    <h3><%= group.name %></h3>
                </div>
                <hr class="my-4">
                <div id="group-info" class="group-info">
                    <p class="description"><%= group.description %></p>
                    <p class="text-muted">Created by: <%= group.createdBy %></p>
                </div>
            <!-- Main Content -->
            <main class="col main-col">
                </div>
                <div  id ="main-content" class="main-content mt-4 d-flex justify-content-center">
                     <ul id="post-list" class="list-unstyled w-100" style="max-width: 600px;" data-group-name="<%= group.name %>">

                         <!-- Posts will be dynamically inserted here -->

                    </ul>
                </div>
            </main>

            <div class="col-2 right-col d-none d-lg-block ml-4"></div>
        </div>
    </div>

    <% if (locals.user) { %>
        <script>
            window.currentUsername = "<%= user.username %>";
        </script>
    <% } %>
    <script src="/js/posts.js"></script>
    <script src="/js/groups.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>